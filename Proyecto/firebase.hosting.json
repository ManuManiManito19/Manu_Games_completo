{
  "hosting": {
    "public": "dist/Front_end/browser",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "X-Frame-Options", "value": "DENY"},
          {"key": "Referrer-Policy", "value": "same-origin"},
          {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
        ]
      }
    ],
    "rewrites": [
      {"source": "/api/**", "run": {"serviceId": "manu-games", "region": "us-central1"}},
      {"source": "**", "destination": "/index.html"}
    ]
  }
}
