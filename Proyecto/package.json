{
  "name": "manu-games",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build && npm run serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:store",
    "serve": "node --env-file-if-exists=Back_End/.env Back_End/server.js",
    "db:bootstrap": "node --env-file-if-exists=Back_End/.env Back_End/src/operations.cjs bootstrap",
    "db:backup": "node --env-file-if-exists=Back_End/.env Back_End/src/operations.cjs backup",
    "db:restore": "node --env-file-if-exists=Back_End/.env Back_End/src/operations.cjs restore",
    "test:store": "node --test Back_End/test/*.test.cjs",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "db:catalog": "node --env-file-if-exists=Back_End/.env Back_End/src/operations.cjs catalog"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "google-auth-library": "^11.3.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/node": "^20.17.19",
    "typescript": "~6.0.2"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  }
}
